{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "lib": [
      "ES2025"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "drizzle.config.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.integration.config.ts"
  ]
}
